---
/**
 * 回到顶部。标记照抄 _baseline/html/ 的 <button class="to-top">。
 */
---

<button class="to-top" type="button" data-to-top aria-label="回到顶部" tabindex="-1">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path>
  </svg>
</button>
